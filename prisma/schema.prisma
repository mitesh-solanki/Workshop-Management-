generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  TECHNICIAN
  ACCOUNTANT
}

enum ServiceOrderStatus {
  WAITING
  INSPECTION
  IN_PROGRESS
  WAITING_FOR_PARTS
  READY
  COMPLETED
}

enum ServiceOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceOrderLineType {
  LABOUR
  PART
}

enum InspectionItemResult {
  OK
  NEEDS_ATTENTION
  URGENT
}

enum MediaKind {
  PHOTO
  VIDEO
}

enum SuggestedRepairType {
  LABOUR
  PART
}

enum EstimateLineType {
  LABOUR
  PART
}

enum EstimateLineApprovalState {
  PENDING
  APPROVED
  REJECTED
}

enum EstimateApprovalMethod {
  MANUAL
  PHONE
  WHATSAPP
  ONLINE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum PartsRequestStatus {
  OPEN
  ORDERED
  CANCELLED
}

enum PurchaseOrderStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
}

enum InvoiceLineType {
  LABOUR
  PART
}

/// How GST on the invoice is split for place of supply.
enum GstSplitKind {
  CGST_SGST
  IGST
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  MIXED
}

enum PaymentProvider {
  NONE
  RAZORPAY
}

/// Manual cash/card rows are PAID immediately. UPI provider rows start PENDING.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum CreditNoteReason {
  CORRECTION
  REFUND
  OTHER
}

model Garage {
  id        String   @id @default(cuid())
  name      String
  address   String?
  gstin     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  invites           Invite[]
  auditLogs         AuditLog[]
  customers         Customer[]
  vehicles          Vehicle[]
  serviceOrders     ServiceOrder[]
  serviceOrderLines ServiceOrderLine[]
  inspections       Inspection[]
  inspectionItems   InspectionItem[]
  media             Media[]
  suggestedRepairs  SuggestedRepair[]
  estimates         Estimate[]
  estimateLines     EstimateLine[]
  estimateApprovals EstimateApproval[]
  parts             Part[]
  stockMovements    StockMovement[]
  directSales       DirectSale[]
  directSaleLines   DirectSaleLine[]
  invoices          Invoice[]
  invoiceLines      InvoiceLine[]
  invoiceNumberCounters InvoiceNumberCounter[]
  creditNotes       CreditNote[]
  creditNoteLines   CreditNoteLine[]
  creditNoteNumberCounters CreditNoteNumberCounter[]
  payments          Payment[]
  liveLinks         LiveLink[]
  vendors           Vendor[]
  partsRequests     PartsRequest[]
  purchaseOrders    PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  purchaseOrderNumberCounters PurchaseOrderNumberCounter[]
  goodsReceipts     GoodsReceipt[]
  goodsReceiptLines GoodsReceiptLine[]
  vendorBills       VendorBill[]
  vendorBillPayments VendorBillPayment[]
  purchaseReturns   PurchaseReturn[]
  bays              Bay[]
  vehicleWarrantyDocuments VehicleWarrantyDocument[]
  serviceOrderTechnicianAssignments ServiceOrderTechnicianAssignment[]
}

/// Physical service bay in the workshop (master list for job cards).
model Bay {
  id        String   @id @default(cuid())
  garageId  String
  garage    Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, name])
  @@index([garageId])
  @@index([garageId, active])
  @@index([garageId, sortOrder])
}

model Customer {
  id        String   @id @default(cuid())
  garageId  String
  garage    Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]
  inspections   Inspection[]
  directSales   DirectSale[]
  invoices      Invoice[]
  vehicleWarrantyDocuments VehicleWarrantyDocument[]

  @@index([garageId])
  @@index([garageId, phone])
  @@index([garageId, name])
}

model Vehicle {
  id                 String    @id @default(cuid())
  garageId           String
  garage             Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  registrationNumber String
  make               String
  model              String
  /// GST state / UT code for place of supply (e.g. "24" Gujarat). Default Gujarat.
  stateCode          String    @default("24")
  year               Int?
  odometer           Int?
  insuranceExpiry    DateTime?
  pucExpiry          DateTime?
  fitnessExpiry      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  serviceOrders ServiceOrder[]
  inspections   Inspection[]
  warrantyDocuments VehicleWarrantyDocument[]

  @@unique([garageId, registrationNumber])
  @@index([garageId])
  @@index([customerId])
}

/// Warranty card photo + expiry stored against a vehicle (e.g. battery on invoice).
model VehicleWarrantyDocument {
  id                 String    @id @default(cuid())
  garageId           String
  garage             Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicleId          String
  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  partName           String
  invoiceId          String?
  invoice            Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceLineId      String?   @unique
  invoiceLine        InvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  warrantyExpiresAt  DateTime?
  storageKey         String?
  contentType        String?
  byteSize           Int?
  fileName           String?
  createdById        String?
  createdBy          User?     @relation("WarrantyDocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([garageId])
  @@index([garageId, vehicleId])
  @@index([garageId, customerId])
  @@index([invoiceId])
}

model ServiceOrder {
  id                 String             @id @default(cuid())
  garageId           String
  garage             Garage             @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicleId          String
  vehicle            Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status             ServiceOrderStatus   @default(WAITING)
  priority           ServiceOrderPriority @default(NORMAL)
  complaint          String
  requestedServices  String?
  odometerIn         Int?
  expectedCompletion DateTime?
  technicianId       String?
  technician         User?                @relation("ServiceOrderTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  bay                String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  lines          ServiceOrderLine[]
  technicianAssignments ServiceOrderTechnicianAssignment[]
  inspection     Inspection?
  estimates      Estimate[]
  invoices       Invoice[]
  stockMovements StockMovement[]
  liveLinks      LiveLink[]
  partsRequests  PartsRequest[]

  @@index([garageId])
  @@index([garageId, status])
  @@index([garageId, technicianId])
  @@index([vehicleId])
  @@index([customerId])
}

/** Many technicians can be assigned to one job card. */
model ServiceOrderTechnicianAssignment {
  id             String       @id @default(cuid())
  garageId       String
  garage         Garage       @relation(fields: [garageId], references: [id], onDelete: Cascade)
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  technicianId   String
  technician     User         @relation("ServiceOrderAssignedTechnicians", fields: [technicianId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([serviceOrderId, technicianId])
  @@index([garageId, technicianId])
  @@index([serviceOrderId])
}

model ServiceOrderLine {
  id             String                @id @default(cuid())
  garageId       String
  garage         Garage                @relation(fields: [garageId], references: [id], onDelete: Cascade)
  serviceOrderId String
  serviceOrder   ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  type           ServiceOrderLineType
  description    String
  quantity       Int                   @default(1)
  unitPricePaise Int                   @default(0)
  partId         String?
  part           Part?                 @relation(fields: [partId], references: [id], onDelete: SetNull)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  stockMovement StockMovement?
  partsRequests PartsRequest[]

  @@index([garageId])
  @@index([serviceOrderId])
  @@index([partId])
}

/// Inventory part catalogue. Current stock is derived from StockMovement rows only.
model Part {
  id                 String   @id @default(cuid())
  garageId           String
  garage             Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  name               String
  sku                String
  unit               String
  purchasePricePaise Int      @default(0)
  sellingPricePaise  Int      @default(0)
  gstRatePercent     Int      @default(18)
  hsn                String
  lowStockLevel      Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  movements         StockMovement[]
  serviceOrderLines ServiceOrderLine[]
  directSaleLines   DirectSaleLine[]
  partsRequests     PartsRequest[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines GoodsReceiptLine[]
  purchaseReturns   PurchaseReturn[]
  suggestedRepairs  SuggestedRepair[]

  @@unique([garageId, sku])
  @@index([garageId])
  @@index([garageId, name])
}

/// The only way stock quantity changes. quantityChange is signed (IN > 0, OUT < 0).
model StockMovement {
  id                 String            @id @default(cuid())
  garageId           String
  garage             Garage            @relation(fields: [garageId], references: [id], onDelete: Cascade)
  partId             String
  part               Part              @relation(fields: [partId], references: [id], onDelete: Restrict)
  type               StockMovementType
  quantityChange     Int
  note               String?
  serviceOrderId     String?
  serviceOrder       ServiceOrder?     @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  serviceOrderLineId String?           @unique
  serviceOrderLine   ServiceOrderLine? @relation(fields: [serviceOrderLineId], references: [id], onDelete: SetNull)
  directSaleId       String?
  directSale         DirectSale?       @relation(fields: [directSaleId], references: [id], onDelete: SetNull)
  directSaleLineId   String?           @unique
  directSaleLine     DirectSaleLine?   @relation(fields: [directSaleLineId], references: [id], onDelete: SetNull)
  goodsReceiptLineId String?           @unique
  goodsReceiptLine   GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id], onDelete: SetNull)
  purchaseReturnId   String?           @unique
  purchaseReturn     PurchaseReturn?   @relation(fields: [purchaseReturnId], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          User?             @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())

  @@index([garageId, partId, createdAt])
  @@index([garageId, createdAt])
  @@index([serviceOrderId])
  @@index([directSaleId])
  @@index([goodsReceiptLineId])
  @@index([purchaseReturnId])
}

/// Counter sale of parts without a service order.
model DirectSale {
  id          String    @id @default(cuid())
  garageId    String
  garage      Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Optional name when the buyer is walk-in (no customer record).
  walkInName  String?
  notes       String?
  createdById String?
  createdBy   User?     @relation("DirectSaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  lines          DirectSaleLine[]
  stockMovements StockMovement[]

  @@index([garageId, createdAt])
  @@index([customerId])
}

model DirectSaleLine {
  id             String     @id @default(cuid())
  garageId       String
  garage         Garage     @relation(fields: [garageId], references: [id], onDelete: Cascade)
  directSaleId   String
  directSale     DirectSale @relation(fields: [directSaleId], references: [id], onDelete: Cascade)
  partId         String
  part           Part       @relation(fields: [partId], references: [id], onDelete: Restrict)
  quantity       Int
  unitPricePaise Int
  gstRatePercent Int        @default(18)
  hsn            String
  sortOrder      Int        @default(0)

  stockMovement StockMovement?

  @@index([garageId])
  @@index([directSaleId])
  @@index([partId])
}

/// Supplier of spare parts.
model Vendor {
  id        String   @id @default(cuid())
  garageId  String
  garage    Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  gstin     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  vendorBills     VendorBill[]
  purchaseReturns PurchaseReturn[]

  @@index([garageId])
  @@index([garageId, name])
}

/// Request to buy a part that is short or low in stock.
model PartsRequest {
  id                 String             @id @default(cuid())
  garageId           String
  garage             Garage             @relation(fields: [garageId], references: [id], onDelete: Cascade)
  partId             String
  part               Part               @relation(fields: [partId], references: [id], onDelete: Restrict)
  quantity           Int
  status             PartsRequestStatus @default(OPEN)
  notes              String?
  serviceOrderId     String?
  serviceOrder       ServiceOrder?      @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  serviceOrderLineId String?
  serviceOrderLine   ServiceOrderLine?  @relation(fields: [serviceOrderLineId], references: [id], onDelete: SetNull)
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          User?              @relation("PartsRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([garageId, status, createdAt])
  @@index([partId])
  @@index([purchaseOrderId])
  @@index([serviceOrderId])
}

model PurchaseOrderNumberCounter {
  id         String @id @default(cuid())
  garageId   String @unique
  garage     Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)
  lastNumber Int    @default(0)
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  garageId    String
  garage      Garage              @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  number      String
  status      PurchaseOrderStatus @default(PENDING)
  notes       String?
  createdById String?
  createdBy   User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  lines         PurchaseOrderLine[]
  partsRequests PartsRequest[]
  goodsReceipts GoodsReceipt[]
  vendorBills   VendorBill[]

  @@unique([garageId, number])
  @@index([garageId, status, createdAt])
  @@index([vendorId])
}

model PurchaseOrderLine {
  id               String        @id @default(cuid())
  garageId         String
  garage           Garage        @relation(fields: [garageId], references: [id], onDelete: Cascade)
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  partId           String
  part             Part          @relation(fields: [partId], references: [id], onDelete: Restrict)
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCostPaise    Int           @default(0)
  sortOrder        Int           @default(0)

  goodsReceiptLines GoodsReceiptLine[]

  @@index([garageId])
  @@index([purchaseOrderId])
  @@index([partId])
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  garageId        String
  garage          Garage        @relation(fields: [garageId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  notes           String?
  createdById     String?
  createdBy       User?         @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  lines GoodsReceiptLine[]

  @@index([garageId, createdAt])
  @@index([purchaseOrderId])
}

model GoodsReceiptLine {
  id                  String            @id @default(cuid())
  garageId            String
  garage              Garage            @relation(fields: [garageId], references: [id], onDelete: Cascade)
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  partId              String
  part                Part              @relation(fields: [partId], references: [id], onDelete: Restrict)
  quantity            Int

  stockMovement StockMovement?

  @@index([garageId])
  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
  @@index([partId])
}

model VendorBill {
  id              String         @id @default(cuid())
  garageId        String
  garage          Garage         @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  billNumber      String?
  billDate        DateTime       @default(now())
  amountPaise     Int
  notes                  String?
  attachmentStorageKey   String?
  attachmentContentType  String?
  attachmentFileName     String?
  attachmentByteSize     Int?
  createdById     String?
  createdBy       User?          @relation("VendorBillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  payments VendorBillPayment[]
  returns  PurchaseReturn[]

  @@index([garageId, billDate])
  @@index([vendorId])
  @@index([purchaseOrderId])
}

model VendorBillPayment {
  id          String     @id @default(cuid())
  garageId    String
  garage      Garage     @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vendorBillId String
  vendorBill  VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  amountPaise Int
  method      String     @default("CASH")
  paidAt      DateTime   @default(now())
  notes       String?
  createdById String?
  createdBy   User?      @relation("VendorBillPaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([garageId, paidAt])
  @@index([vendorBillId])
}

model PurchaseReturn {
  id           String      @id @default(cuid())
  garageId     String
  garage       Garage      @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vendorId     String
  vendor       Vendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorBillId String?
  vendorBill   VendorBill? @relation(fields: [vendorBillId], references: [id], onDelete: SetNull)
  partId       String
  part         Part        @relation(fields: [partId], references: [id], onDelete: Restrict)
  quantity     Int
  /// Credit applied against the vendor bill / outstanding (paise).
  creditPaise  Int
  notes        String?
  createdById  String?
  createdBy    User?       @relation("PurchaseReturnCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  stockMovement StockMovement?

  @@index([garageId, createdAt])
  @@index([vendorId])
  @@index([vendorBillId])
  @@index([partId])
}

/// Digital inspection for a vehicle visit. Job card link is optional.
model Inspection {
  id             String        @id @default(cuid())
  garageId       String
  garage         Garage        @relation(fields: [garageId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleId      String
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  serviceOrderId   String?       @unique
  serviceOrder     ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  notes            String?
  complaint        String?
  recommendedNotes String?
  /// When the vehicle is expected to be ready (copied to job card on create).
  expectedCompletion DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items            InspectionItem[]
  media            Media[]
  suggestedRepairs SuggestedRepair[]
  estimates        Estimate[]
  liveLinks        LiveLink[]

  @@index([garageId])
  @@index([garageId, customerId])
  @@index([garageId, vehicleId])
  @@index([garageId, createdAt])
}

model InspectionItem {
  id             String                 @id @default(cuid())
  garageId       String
  garage         Garage                 @relation(fields: [garageId], references: [id], onDelete: Cascade)
  inspectionId   String
  inspection     Inspection             @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  /// Stable key for default items (brakes, tyres, …); custom items use a generated key.
  key            String
  label          String
  result         InspectionItemResult?
  notes          String?
  quantity       Int                    @default(1)
  unitPricePaise Int                    @default(0)
  externalCheck  Boolean                @default(false)
  sortOrder      Int                    @default(0)
  isCustom       Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  media Media[]

  @@unique([inspectionId, key])
  @@index([garageId])
  @@index([inspectionId])
}

model Media {
  id               String    @id @default(cuid())
  garageId         String
  garage           Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  inspectionId     String
  inspection       Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionItemId String?
  inspectionItem   InspectionItem? @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)
  kind             MediaKind
  storageKey       String
  contentType      String
  byteSize         Int
  createdAt        DateTime  @default(now())

  @@index([garageId])
  @@index([inspectionId])
  @@index([inspectionItemId])
}

model SuggestedRepair {
  id             String               @id @default(cuid())
  garageId       String
  garage         Garage               @relation(fields: [garageId], references: [id], onDelete: Cascade)
  inspectionId   String
  inspection     Inspection           @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  type           SuggestedRepairType
  description    String
  quantity       Int                  @default(1)
  unitPricePaise Int                  @default(0)
  partId         String?
  part           Part?                @relation(fields: [partId], references: [id], onDelete: SetNull)
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([garageId])
  @@index([inspectionId])
  @@index([partId])
}

/// Customer-facing estimate for a service order visit. Revisions keep history.
enum EstimatePermissionVia {
  MANUAL
  LIVE_LINK
}

model Estimate {
  id             String    @id @default(cuid())
  garageId       String
  garage         Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  /// Job-card estimate when set. Mutually exclusive with inspectionId.
  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  /// Standalone inspection estimate when set. Mutually exclusive with serviceOrderId.
  inspectionId   String?
  inspection     Inspection? @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  /// Starts at 1; each revision increments. Old revisions are never deleted.
  revisionNumber Int
  notes          String?
  /// When false, priced lines are created APPROVED and ready to bill.
  askPermission  Boolean   @default(false)
  /// How permission is collected when askPermission is true.
  permissionVia  EstimatePermissionVia?
  /// Set when a newer revision replaces this one. Null = current revision.
  supersededAt   DateTime?
  createdById    String?
  createdBy      User?     @relation("EstimateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines     EstimateLine[]
  approvals EstimateApproval[]
  invoices  Invoice[]

  @@index([garageId])
  @@index([serviceOrderId])
  @@index([inspectionId])
  @@index([garageId, serviceOrderId, supersededAt])
  @@index([garageId, inspectionId, supersededAt])
}

model EstimateLine {
  id                      String                     @id @default(cuid())
  garageId                String
  garage                  Garage                     @relation(fields: [garageId], references: [id], onDelete: Cascade)
  estimateId              String
  estimate                Estimate                   @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  type                    EstimateLineType
  description             String
  quantity                Int                        @default(1)
  unitPricePaise          Int                        @default(0)
  /// GST rate as whole percent (e.g. 18 for 18%).
  gstRatePercent          Int                        @default(18)
  /// HSN (parts) or SAC (labour) code.
  hsnOrSac                String
  approvalState           EstimateLineApprovalState  @default(PENDING)
  sourceOrderLineId       String?
  sourceSuggestedRepairId String?
  sortOrder               Int                        @default(0)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  approvals    EstimateApproval[]
  invoiceLines InvoiceLine[]

  @@index([garageId])
  @@index([estimateId])
  @@index([garageId, approvalState])
}

/// Immutable history of approval changes on estimate lines.
model EstimateApproval {
  id             String                    @id @default(cuid())
  garageId       String
  garage         Garage                    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  estimateId     String
  estimate       Estimate                  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  estimateLineId String
  estimateLine   EstimateLine              @relation(fields: [estimateLineId], references: [id], onDelete: Cascade)
  fromState      EstimateLineApprovalState?
  toState        EstimateLineApprovalState
  method         EstimateApprovalMethod
  recordedById   String?
  recordedBy     User?                     @relation("EstimateApprovalRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime                  @default(now())

  @@index([garageId])
  @@index([estimateId, createdAt])
  @@index([estimateLineId, createdAt])
}

/// Per-garage sequential invoice numbers for one financial year (April–March).
model InvoiceNumberCounter {
  id                 String @id @default(cuid())
  garageId           String
  garage             Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)
  /// Calendar year of the FY start (e.g. 2025 for FY 2025-26).
  financialYearStart Int
  lastNumber         Int    @default(0)

  @@unique([garageId, financialYearStart])
  @@index([garageId])
}

/// Per-garage sequential credit-note numbers for one financial year.
model CreditNoteNumberCounter {
  id                 String @id @default(cuid())
  garageId           String
  garage             Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)
  financialYearStart Int
  lastNumber         Int    @default(0)

  @@unique([garageId, financialYearStart])
  @@index([garageId])
}

/// Tax invoice built from approved estimate lines. Finalized rows are immutable.
model Invoice {
  id                     String        @id @default(cuid())
  garageId               String
  garage                 Garage        @relation(fields: [garageId], references: [id], onDelete: Cascade)
  serviceOrderId         String
  serviceOrder           ServiceOrder  @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  estimateId             String
  estimate               Estimate      @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  customerId             String
  customer               Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status                 InvoiceStatus @default(DRAFT)
  /// Set on finalization, e.g. INV/2025-26/0001. Null while draft.
  invoiceNumber          String?
  financialYearStart     Int?
  sequenceNumber         Int?
  /// Seller (garage) GST state code, e.g. "24" for Gujarat.
  sellerStateCode        String
  /// Place of supply state code for GST split.
  placeOfSupplyStateCode String
  gstSplit               GstSplitKind
  taxablePaise           Int           @default(0)
  cgstPaise              Int           @default(0)
  sgstPaise              Int           @default(0)
  igstPaise              Int           @default(0)
  totalPaise             Int           @default(0)
  /// Sum of recorded payments (paise). Pending = total − credit notes − paid.
  amountPaidPaise        Int           @default(0)
  notes                  String?
  finalizedAt            DateTime?
  createdById            String?
  createdBy              User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  lines       InvoiceLine[]
  payments    Payment[]
  creditNotes CreditNote[]
  warrantyDocuments VehicleWarrantyDocument[]

  @@unique([garageId, invoiceNumber])
  @@unique([garageId, financialYearStart, sequenceNumber])
  @@index([garageId])
  @@index([garageId, serviceOrderId])
  @@index([garageId, status])
  @@index([estimateId])
  @@index([customerId])
}

model InvoiceLine {
  id               String          @id @default(cuid())
  garageId         String
  garage           Garage          @relation(fields: [garageId], references: [id], onDelete: Cascade)
  invoiceId        String
  invoice          Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  estimateLineId   String?
  estimateLine     EstimateLine?   @relation(fields: [estimateLineId], references: [id], onDelete: SetNull)
  type             InvoiceLineType
  description      String
  quantity         Int
  unitPricePaise   Int
  gstRatePercent   Int
  hsnOrSac         String
  taxablePaise     Int
  cgstPaise        Int             @default(0)
  sgstPaise        Int             @default(0)
  igstPaise        Int             @default(0)
  totalPaise       Int
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())

  warrantyDocument VehicleWarrantyDocument?

  @@index([garageId])
  @@index([invoiceId])
  @@index([estimateLineId])
}

/// Correction or refund against a finalized invoice. Does not edit the invoice.
model CreditNote {
  id                 String           @id @default(cuid())
  garageId           String
  garage             Garage           @relation(fields: [garageId], references: [id], onDelete: Cascade)
  invoiceId          String
  invoice            Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  creditNoteNumber   String
  financialYearStart Int
  sequenceNumber     Int
  reason             CreditNoteReason
  taxablePaise       Int              @default(0)
  cgstPaise          Int              @default(0)
  sgstPaise          Int              @default(0)
  igstPaise          Int              @default(0)
  totalPaise         Int              @default(0)
  notes              String?
  createdById        String?
  createdBy          User?            @relation("CreditNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())

  lines CreditNoteLine[]

  @@unique([garageId, creditNoteNumber])
  @@unique([garageId, financialYearStart, sequenceNumber])
  @@index([garageId])
  @@index([invoiceId])
}

model CreditNoteLine {
  id             String     @id @default(cuid())
  garageId       String
  garage         Garage     @relation(fields: [garageId], references: [id], onDelete: Cascade)
  creditNoteId   String
  creditNote     CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int        @default(1)
  unitPricePaise Int
  gstRatePercent Int
  hsnOrSac       String
  taxablePaise   Int
  cgstPaise      Int        @default(0)
  sgstPaise      Int        @default(0)
  igstPaise      Int        @default(0)
  totalPaise     Int
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([garageId])
  @@index([creditNoteId])
}

model Payment {
  id          String        @id @default(cuid())
  garageId    String
  garage      Garage        @relation(fields: [garageId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  method      PaymentMethod
  amountPaise Int
  /// When true, money returned to customer; reduces amountPaidPaise.
  isRefund    Boolean       @default(false)
  /// Breakdown for MIXED (and optional detail for single methods). Must sum to amountPaise.
  cashPaise   Int           @default(0)
  upiPaise    Int           @default(0)
  cardPaise   Int           @default(0)
  note        String?
  /// Manual payments are PAID; Razorpay UPI starts PENDING until webhook.
  status      PaymentStatus @default(PAID)
  provider    PaymentProvider @default(NONE)
  /// Razorpay payment id (pay_…). Unique when set — webhook marks paid once.
  providerPaymentId     String?
  providerOrderId       String?
  providerPaymentLinkId String?
  paymentLinkUrl        String?
  qrImageDataUrl        String?  @db.Text
  receivedAt  DateTime      @default(now())
  createdById String?
  createdBy   User?         @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([garageId])
  @@index([invoiceId, receivedAt])
  @@index([providerPaymentLinkId])
}

/// Public customer live link for a job card or an inspection estimate.
/// Exactly one of serviceOrderId / inspectionId is set. Store only the token hash.
model LiveLink {
  id             String    @id @default(cuid())
  garageId       String
  garage         Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  inspectionId   String?
  inspection     Inspection? @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  /// SHA-256 of the 32-byte raw token. Raw token is never stored.
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdById    String?
  createdBy      User?     @relation("LiveLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([garageId])
  @@index([serviceOrderId, revokedAt])
  @@index([inspectionId, revokedAt])
  @@index([expiresAt])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role
  garageId      String
  garage        Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  auditLogs           AuditLog[]            @relation("AuditActor")
  assignedOrders      ServiceOrder[]        @relation("ServiceOrderTechnician")
  orderAssignments    ServiceOrderTechnicianAssignment[] @relation("ServiceOrderAssignedTechnicians")
  estimatesCreated    Estimate[]            @relation("EstimateCreatedBy")
  approvalsRecorded   EstimateApproval[]    @relation("EstimateApprovalRecorder")
  stockMovementsCreated StockMovement[]     @relation("StockMovementCreatedBy")
  directSalesCreated  DirectSale[]          @relation("DirectSaleCreatedBy")
  invoicesCreated     Invoice[]             @relation("InvoiceCreatedBy")
  creditNotesCreated  CreditNote[]          @relation("CreditNoteCreatedBy")
  paymentsCreated     Payment[]             @relation("PaymentCreatedBy")
  liveLinksCreated    LiveLink[]            @relation("LiveLinkCreatedBy")
  partsRequestsCreated PartsRequest[]       @relation("PartsRequestCreatedBy")
  purchaseOrdersCreated PurchaseOrder[]     @relation("PurchaseOrderCreatedBy")
  goodsReceiptsCreated GoodsReceipt[]       @relation("GoodsReceiptCreatedBy")
  vendorBillsCreated  VendorBill[]          @relation("VendorBillCreatedBy")
  vendorBillPaymentsCreated VendorBillPayment[] @relation("VendorBillPaymentCreatedBy")
  purchaseReturnsCreated PurchaseReturn[]   @relation("PurchaseReturnCreatedBy")
  warrantyDocumentsCreated VehicleWarrantyDocument[] @relation("WarrantyDocumentCreatedBy")

  @@index([garageId])
}

model AuditLog {
  id        String   @id @default(cuid())
  garageId  String
  garage    Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([garageId, createdAt])
}

model Invite {
  id              String    @id @default(cuid())
  garageId        String
  garage          Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  email           String
  role            Role
  tokenHash       String    @unique
  invitedBy       String
  locale          String    @default("en")
  expiresAt       DateTime
  acceptedAt      DateTime?
  lastEmailStatus String?
  lastEmailAt     DateTime?
  lastEmailError  String?
  createdAt       DateTime  @default(now())

  @@unique([garageId, email])
  @@index([email])
}

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  purpose    String
  payload    Json?
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}

model EmailLog {
  id                String   @id @default(cuid())
  type              String
  recipientHash     String
  recipientMasked   String
  provider          String
  success           Boolean
  providerRequestId String?
  errorCode         String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([recipientHash, createdAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
