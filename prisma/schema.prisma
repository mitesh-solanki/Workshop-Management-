generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  TECHNICIAN
  ACCOUNTANT
}

enum ServiceOrderStatus {
  WAITING
  INSPECTION
  IN_PROGRESS
  WAITING_FOR_PARTS
  READY
  COMPLETED
}

enum ServiceOrderLineType {
  LABOUR
  PART
}

enum InspectionItemResult {
  OK
  NEEDS_ATTENTION
  URGENT
}

enum MediaKind {
  PHOTO
  VIDEO
}

enum SuggestedRepairType {
  LABOUR
  PART
}

enum EstimateLineType {
  LABOUR
  PART
}

enum EstimateLineApprovalState {
  PENDING
  APPROVED
  REJECTED
}

enum EstimateApprovalMethod {
  MANUAL
  PHONE
  WHATSAPP
  ONLINE
}

model Garage {
  id        String   @id @default(cuid())
  name      String
  address   String?
  gstin     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  invites        Invite[]
  auditLogs      AuditLog[]
  customers           Customer[]
  vehicles            Vehicle[]
  serviceOrders       ServiceOrder[]
  serviceOrderLines   ServiceOrderLine[]
  inspections         Inspection[]
  inspectionItems     InspectionItem[]
  media               Media[]
  suggestedRepairs    SuggestedRepair[]
  estimates           Estimate[]
  estimateLines       EstimateLine[]
  estimateApprovals   EstimateApproval[]
}

model Customer {
  id        String   @id @default(cuid())
  garageId  String
  garage    Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]

  @@index([garageId])
  @@index([garageId, phone])
  @@index([garageId, name])
}

model Vehicle {
  id                 String    @id @default(cuid())
  garageId           String
  garage             Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  registrationNumber String
  make               String
  model              String
  year               Int?
  odometer           Int?
  insuranceExpiry    DateTime?
  pucExpiry          DateTime?
  fitnessExpiry      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  serviceOrders ServiceOrder[]

  @@unique([garageId, registrationNumber])
  @@index([garageId])
  @@index([customerId])
}

model ServiceOrder {
  id                 String             @id @default(cuid())
  garageId           String
  garage             Garage             @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicleId          String
  vehicle            Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status             ServiceOrderStatus @default(WAITING)
  complaint          String
  requestedServices  String?
  odometerIn         Int?
  expectedCompletion DateTime?
  technicianId       String?
  technician         User?              @relation("ServiceOrderTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  bay                String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  lines       ServiceOrderLine[]
  inspection  Inspection?
  estimates   Estimate[]

  @@index([garageId])
  @@index([garageId, status])
  @@index([garageId, technicianId])
  @@index([vehicleId])
  @@index([customerId])
}

model ServiceOrderLine {
  id             String                @id @default(cuid())
  garageId       String
  garage         Garage                @relation(fields: [garageId], references: [id], onDelete: Cascade)
  serviceOrderId String
  serviceOrder   ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  type           ServiceOrderLineType
  description    String
  quantity       Int                   @default(1)
  unitPricePaise Int                   @default(0)
  /// Reserved for inventory Part link (Prompt 7).
  partId         String?
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([garageId])
  @@index([serviceOrderId])
}

/// Digital inspection for one service order visit.
model Inspection {
  id             String   @id @default(cuid())
  garageId       String
  garage         Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  serviceOrderId String   @unique
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items            InspectionItem[]
  media            Media[]
  suggestedRepairs SuggestedRepair[]

  @@index([garageId])
}

model InspectionItem {
  id           String                 @id @default(cuid())
  garageId     String
  garage       Garage                 @relation(fields: [garageId], references: [id], onDelete: Cascade)
  inspectionId String
  inspection   Inspection             @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  /// Stable key for default items (brakes, tyres, …); custom items use a generated key.
  key          String
  label        String
  result       InspectionItemResult?
  notes        String?
  sortOrder    Int                    @default(0)
  isCustom     Boolean                @default(false)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  media Media[]

  @@unique([inspectionId, key])
  @@index([garageId])
  @@index([inspectionId])
}

model Media {
  id               String    @id @default(cuid())
  garageId         String
  garage           Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  inspectionId     String
  inspection       Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionItemId String?
  inspectionItem   InspectionItem? @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)
  kind             MediaKind
  storageKey       String
  contentType      String
  byteSize         Int
  createdAt        DateTime  @default(now())

  @@index([garageId])
  @@index([inspectionId])
  @@index([inspectionItemId])
}

model SuggestedRepair {
  id             String               @id @default(cuid())
  garageId       String
  garage         Garage               @relation(fields: [garageId], references: [id], onDelete: Cascade)
  inspectionId   String
  inspection     Inspection           @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  type           SuggestedRepairType
  description    String
  quantity       Int                  @default(1)
  unitPricePaise Int                  @default(0)
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([garageId])
  @@index([inspectionId])
}

/// Customer-facing estimate for a service order visit. Revisions keep history.
model Estimate {
  id             String    @id @default(cuid())
  garageId       String
  garage         Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  /// Starts at 1; each revision increments. Old revisions are never deleted.
  revisionNumber Int
  notes          String?
  /// Set when a newer revision replaces this one. Null = current revision.
  supersededAt   DateTime?
  createdById    String?
  createdBy      User?     @relation("EstimateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines     EstimateLine[]
  approvals EstimateApproval[]

  @@unique([serviceOrderId, revisionNumber])
  @@index([garageId])
  @@index([serviceOrderId])
  @@index([garageId, serviceOrderId, supersededAt])
}

model EstimateLine {
  id                      String                     @id @default(cuid())
  garageId                String
  garage                  Garage                     @relation(fields: [garageId], references: [id], onDelete: Cascade)
  estimateId              String
  estimate                Estimate                   @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  type                    EstimateLineType
  description             String
  quantity                Int                        @default(1)
  unitPricePaise          Int                        @default(0)
  /// GST rate as whole percent (e.g. 18 for 18%).
  gstRatePercent          Int                        @default(18)
  /// HSN (parts) or SAC (labour) code.
  hsnOrSac                String
  approvalState           EstimateLineApprovalState  @default(PENDING)
  sourceOrderLineId       String?
  sourceSuggestedRepairId String?
  sortOrder               Int                        @default(0)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  approvals EstimateApproval[]

  @@index([garageId])
  @@index([estimateId])
  @@index([garageId, approvalState])
}

/// Immutable history of approval changes on estimate lines.
model EstimateApproval {
  id             String                    @id @default(cuid())
  garageId       String
  garage         Garage                    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  estimateId     String
  estimate       Estimate                  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  estimateLineId String
  estimateLine   EstimateLine              @relation(fields: [estimateLineId], references: [id], onDelete: Cascade)
  fromState      EstimateLineApprovalState?
  toState        EstimateLineApprovalState
  method         EstimateApprovalMethod
  recordedById   String?
  recordedBy     User?                     @relation("EstimateApprovalRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime                  @default(now())

  @@index([garageId])
  @@index([estimateId, createdAt])
  @@index([estimateLineId, createdAt])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role
  garageId      String
  garage        Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  auditLogs          AuditLog[]     @relation("AuditActor")
  assignedOrders     ServiceOrder[] @relation("ServiceOrderTechnician")
  estimatesCreated   Estimate[]     @relation("EstimateCreatedBy")
  approvalsRecorded  EstimateApproval[] @relation("EstimateApprovalRecorder")

  @@index([garageId])
}

model AuditLog {
  id        String   @id @default(cuid())
  garageId  String
  garage    Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([garageId, createdAt])
}

model Invite {
  id         String    @id @default(cuid())
  garageId   String
  garage     Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  email      String
  role       Role
  tokenHash  String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([garageId, email])
  @@index([email])
}

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  purpose    String
  payload    Json?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
