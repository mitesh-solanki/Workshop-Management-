# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://workshop:workshop@localhost:5432/workshop?schema=public"
# Optional: pin demo seed to a garage (`npm run db:seed`). Default: garage named "prime".
# SEED_GARAGE_ID=

# Redis (BullMQ jobs)
REDIS_URL="redis://localhost:6379"

# Auth.js — set a long random string in real environments
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Optional fixed OTP for local/dev/e2e only (ignored when NODE_ENV=production).
# When set, login/signup still works if Resend fails — enter this code in the OTP step.
# Never shown in the UI.
AUTH_DEV_OTP=123456

# Production-only email+password login (ignored unless NODE_ENV=production).
# Creates the owner + garage on first successful sign-in if the email is new.
# Also ensures a dummy mechanic (TECHNICIAN) in that garage for assignment / board filter.
# Set these only on the production server — never commit real values.
# AUTH_PROD_EMAIL="owner@primemotors.in"
# AUTH_PROD_PASSWORD="Workshop@123"
# AUTH_PROD_NAME="Prime Motors Owner"
# AUTH_PROD_GARAGE_NAME="Prime Motors"
# Optional dummy mechanic (defaults shown). Password falls back to AUTH_PROD_PASSWORD.
# AUTH_PROD_TECH_EMAIL="mechanic@primemotors.in"
# AUTH_PROD_TECH_PASSWORD="Mechanic@123"
# AUTH_PROD_TECH_NAME="Demo Mechanic"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email — Resend for both development and production
RESEND_API_KEY=
EMAIL_FROM="Workshop <onboarding@resend.dev>"

# File storage — pick one. Cloudinary is the temp production option.
# When CLOUDINARY_* is set, it is used automatically (or set STORAGE_DRIVER=cloudinary).
# Local MinIO/S3: leave Cloudinary empty and set S3_* (or STORAGE_DRIVER=s3).
# STORAGE_DRIVER=cloudinary

# Cloudinary (Dashboard → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Media Library root folder (default: workshop)
CLOUDINARY_FOLDER=workshop

# S3-compatible storage (local MinIO / R2 / AWS)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_S3_ENDPOINT=

# --- Local MinIO only (docker compose up -d minio) — uncomment to use ---
# S3_ENDPOINT="http://127.0.0.1:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="workshop"
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# NEXT_PUBLIC_S3_ENDPOINT="http://127.0.0.1:9000"

# Razorpay (UPI QR + payment links). Required for Pay now / Generate UPI.
# After a real payment link locally, mark paid with:
#   npm run razorpay:webhook-local
# Optional override: WEBHOOK_LOCAL_URL=http://localhost:3000
# Enable events (public webhook): payment_link.paid, payment.captured
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
