# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://workshop:workshop@localhost:5432/workshop?schema=public"
# Optional: pin demo seed to a garage (`npm run db:seed`). Default: garage named "prime".
# SEED_GARAGE_ID=

# Redis (BullMQ jobs)
REDIS_URL="redis://localhost:6379"

# Auth.js — set a long random string in real environments
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Optional fixed OTP for local/dev/e2e only (ignored when NODE_ENV=production).
# When set, login/signup still works if Resend fails — enter this code in the OTP step.
# Never shown in the UI.
AUTH_DEV_OTP=123456

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email — Resend for both development and production
RESEND_API_KEY=
EMAIL_FROM="Workshop <onboarding@resend.dev>"

# S3-compatible storage (optional until file uploads are built)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_S3_ENDPOINT=

# --- Local MinIO only (docker compose up -d minio) — uncomment to use ---
# S3_ENDPOINT="http://127.0.0.1:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="workshop"
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# NEXT_PUBLIC_S3_ENDPOINT="http://127.0.0.1:9000"

# Razorpay (UPI QR + payment links). Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/razorpay
# Enable events: payment_link.paid, payment.captured
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
