# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://workshop:workshop@localhost:5432/workshop?schema=public"
# Optional: pin demo seed to a garage (`npm run db:seed`). Default: garage named "prime".
# SEED_GARAGE_ID=

# Redis (BullMQ jobs)
REDIS_URL="redis://localhost:6379"

# Auth.js — set a long random string in real environments
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Optional fixed OTP for local/dev/e2e only (ignored when NODE_ENV=production).
# When set, login/signup still works if Resend fails — enter this code in the OTP step.
# Never shown in the UI.
AUTH_DEV_OTP=123456

# Production-only email+password login (ignored unless NODE_ENV=production).
# Creates the owner + garage on first successful sign-in if the email is new.
# Set these only on the production server — never commit real values.
# AUTH_PROD_EMAIL="owner@primemotors.in"
# AUTH_PROD_PASSWORD="Workshop@123"
# AUTH_PROD_NAME="Prime Motors Owner"
# AUTH_PROD_GARAGE_NAME="Prime Motors"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email — Resend for both development and production
RESEND_API_KEY=
EMAIL_FROM="Workshop <onboarding@resend.dev>"

# S3-compatible storage (optional until file uploads are built)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_S3_ENDPOINT=

# --- Local MinIO only (docker compose up -d minio) — uncomment to use ---
# S3_ENDPOINT="http://127.0.0.1:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="workshop"
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# NEXT_PUBLIC_S3_ENDPOINT="http://127.0.0.1:9000"

# ngrok (optional) — public HTTPS for Razorpay webhooks while developing locally.
# Token: https://dashboard.ngrok.com/get-started/your-authtoken
# Then: npm run ngrok   (with npm run dev on port 3000)
# Webhook URL in Razorpay: https://<ngrok-host>/api/webhooks/razorpay
# If Norton/antivirus HTTPS scan breaks Razorpay (`UNABLE_TO_VERIFY_LEAF_SIGNATURE`),
# `npm run dev` already uses Node `--use-system-ca`. Or exclude Node/ngrok from SSL scan.
NGROK_AUTHTOKEN=

# Razorpay (UPI QR + payment links). Required for Pay now / Generate UPI.
# Without a public tunnel, after a real payment link you can still mark paid with:
#   npm run razorpay:webhook-local
# Optional override: WEBHOOK_LOCAL_URL=http://localhost:3000
# Enable events (public webhook): payment_link.paid, payment.captured
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
